# Шаблon секретов для ad_analytics. Скопируйте в .env и заполните.
# .env в репозиторий НЕ коммитится (см. .gitignore).

# --- Meta (Facebook/Instagram) ---
# Токен системного пользователя с правом ads_read (бессрочный) ИЛИ 60-дневный личный.
META_ACCESS_TOKEN=
# ID кабинета(-ов) через запятую. Можно с префиксом act_ или без — добавится сам.
# Пример: 123456789012345,987654321098765
META_AD_ACCOUNT_IDS=
# Версия Graph API (необязательно).
META_API_VERSION=v21.0

# --- Bitrix24 ---
# Входящий вебхук с правом crm, вида:
# https://ПОРТАЛ.bitrix24.ru/rest/1/xxxxxxxxxxxx/
BITRIX_WEBHOOK_URL=

# Раздел CRM: deal (Сделки) или lead (Лиды). В ОСК работают через Сделки.
BITRIX_ENTITY=deal

# Поле, по которому определяем «квалифицирован/реальный клиент».
# Если не задать — для deal берётся STAGE_SEMANTIC_ID (не зависит от воронки),
# для lead — STATUS_ID.
#   BITRIX_QUALIFIED_FIELD=STAGE_SEMANTIC_ID
# Значения этого поля, считающиеся квалифицированными, через запятую.
# Для deal по умолчанию S (выигранная сделка). Можно указать свои коды стадий
# (напр. C10:WON) или код своего поля-списка «Качество лида».
#   BITRIX_QUALIFIED_VALUES=S
# Поля-кандидаты для ключа связывания с объявлением (первое непустое). По ТЗ в
# объявлениях ставится utm_content={{ad.name}}, поэтому по умолчанию UTM_CONTENT.
# Можно добавить своё UF-поле, напр.: UTM_CONTENT,UF_CRM_1700000000
BITRIX_AD_KEY_FIELDS=UTM_CONTENT
